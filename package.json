{
  "name": "lrsnotes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "test": "node --test",
    "build": "vite build",
    "build:all": "vite build && vitepress build docs",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 3000",
    "docs:dev:lan": "vitepress dev docs --host 0.0.0.0 --port 3000",
    "docs:build": "vitepress build docs",
    "docs:preview": "vite preview --outDir docs/.vitepress/dist --base / --host 127.0.0.1 --port 3000",
    "test:browser": "node scripts/verify-session-conflict.mjs",
    "test:docs": "node scripts/verify-docs.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-enhanced-mark": "2.18.2",
    "@nolebase/vitepress-plugin-enhanced-readabilities": "2.18.2",
    "@nolebase/vitepress-plugin-git-changelog": "2.18.2",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "2.18.2",
    "@nolebase/vitepress-plugin-inline-link-preview": "2.18.2",
    "@nolebase/vitepress-plugin-page-properties": "2.18.2",
    "@shikijs/vitepress-twoslash": "3.23.0",
    "@vitejs/plugin-vue": "5.2.4",
    "canvas-confetti": "1.9.4",
    "dotenv": "^16.4.5",
    "sass": "^1.77.8",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-vue-components": "^0.27.4",
    "vite": "6.4.3",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "1.6.4",
    "vitepress-markdown-timeline": "1.2.2",
    "vitepress-plugin-codeblocks-fold": "1.2.35"
  },
  "overrides": {
    "vitepress": {
      "vite": "$vite"
    },
    "@shikijs/vitepress-twoslash": {
      "floating-vue": "5.2.2"
    }
  }
